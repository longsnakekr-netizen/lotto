<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
        http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

    <!--
    로또라운지 (Lotto Lounge) Sitemap
    사이트맵: 검색엔진이 사이트 구조를 이해하도록 돕는 XML 파일

    주의: <loc> 태그의 URL을 실제 도메인으로 교체해야 합니다.
    예: https://yourdomain.com/ → https://lottlounge.com/
    -->

    <!-- 홈페이지 (최우선) -->
    <url>
        <loc>https://yourdomain.com/</loc>
        <lastmod>2025-12-04</lastmod>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>

    <url>
        <loc>https://yourdomain.com/index.html</loc>
        <lastmod>2025-12-04</lastmod>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>

    <!-- 상품안내 (높은 우선순위) -->
    <url>
        <loc>https://yourdomain.com/products.html</loc>
        <lastmod>2025-12-04</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
    </url>

    <!-- 분석연구실 (높은 우선순위) -->
