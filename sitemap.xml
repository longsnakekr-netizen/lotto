    <url>
        <loc>https://yourdomain.com/terms.html</loc>
        <lastmod>2025-12-04</lastmod>
        <changefreq>yearly</changefreq>
        <priority>0.3</priority>
    </url>

    <url>
        <loc>https://yourdomain.com/privacy.html</loc>
        <lastmod>2025-12-04</lastmod>
        <changefreq>yearly</changefreq>
        <priority>0.3</priority>
    </url>

</urlset>
