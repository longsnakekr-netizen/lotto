        <changefreq>daily</changefreq>
        <priority>0.9</priority>
    </url>

    <!-- 커뮤니티 -->
    <url>
        <loc>https://yourdomain.com/community.html</loc>
        <lastmod>2025-12-04</lastmod>
        <changefreq>daily</changefreq>
        <priority>0.8</priority>
    </url>

    <!-- 플랜 페이지들 -->
    <url>
        <loc>https://yourdomain.com/plan-silver.html</loc>
        <lastmod>2025-12-04</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>

    <url>
        <loc>https://yourdomain.com/plan-gold.html</loc>
        <lastmod>2025-12-04</lastmod>
